# ── BugScanner API ──────────────────────────────────
# Leave empty to run WITHOUT authentication (dev only!)
BUGSCANNER_API_KEY=change-me-to-a-long-random-string

# CORS allowed origins (comma-separated, or * for all)
BUGSCANNER_CORS=http://localhost:5173,http://localhost:8000

# ── Logging ─────────────────────────────────────────
BUGSCANNER_LOG_LEVEL=INFO
# BUGSCANNER_LOG_FILE=./bugscanner.log